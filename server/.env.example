DATABASE_URL=postgres://notes:notes@localhost:5433/notes
PORT=3001

# Optional. For email + password sign-in instead, create accounts with `npm run user -- add <email>`.
# Google OAuth: create a "Web application" client at https://console.cloud.google.com/apis/credentials
# and add {APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser reaches the app: the Vite dev server in development, :3001 in production.
APP_URL=http://localhost:5173

# Comma-separated Google accounts that may sign in (and create their own notebooks).
# People a notebook is shared with can always sign in. Leave empty to let any Google account in.
ALLOWED_EMAILS=
